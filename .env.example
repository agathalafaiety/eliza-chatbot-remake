# Copie para .env para configurar o banco ou habilitar o modo IA.
# Não coloque chaves reais neste arquivo nem em notebooks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Banco em uso; caminhos relativos partem da raiz do projeto.
ELIZA_DATABASE_URL=sqlite:///data/eliza.db
# Memória semântica opcional para o modo Gemini.
ELIZA_CHROMA_PATH=data/chroma
ELIZA_ENABLE_SEMANTIC_MEMORY=false
